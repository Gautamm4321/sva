# ─── Required: waitlist storage (Supabase) ─────────────────────────────
# Project URL: Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key: same page → "service_role" secret. SERVER ONLY.
# Never prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ─── Recommended: site URL (canonical / OG tags) ───────────────────────
NEXT_PUBLIC_SITE_URL=https://svalabs.in

# ─── Optional: Cloudflare Turnstile bot check ──────────────────────────
# Set BOTH to enable. Leave blank to disable (honeypot + timing + rate limit still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Optional: durable rate limiting (Upstash Redis REST) ──────────────
# Without these, a best-effort per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional: salt for hashing IPs in rate-limit keys ─────────────────
RATE_LIMIT_SALT=replace-with-random-string
